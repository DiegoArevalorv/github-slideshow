#!/bin/sh
# Compila el sitio y valida el HTML resultante.
# Se usa igual en local y en GitHub Actions.

set -e

cd "$(dirname "$0")/.."

BUNDLE_PATH="${BUNDLE_PATH:-vendor/bundle}"
export BUNDLE_PATH

# html-proofer lee los HTML con la codificación del sistema; sin esto, los
# acentos y emojis del deck provocan Encoding::InvalidByteSequenceError.
LANG="${LANG:-C.UTF-8}"
LC_ALL="${LC_ALL:-C.UTF-8}"
export LANG LC_ALL

echo "==> Compilando con Jekyll..."
bundle exec jekyll build

echo "==> Validando HTML con html-proofer..."
# Validamos NUESTRAS páginas. Los HTML de ejemplo que reveal.js trae dentro de
# node_modules son código de terceros con enlaces roots propios: no podemos
# arreglarlos y no forman parte de la presentación.
bundle exec htmlproofer _site \
  --root-dir _site \
  --checks Links,Images,Scripts \
  --ignore-files "/node_modules/" \
  --disable-external \
  --ignore-empty-alt \
  --allow-hash-href \
  --no-enforce-https

echo "==> Todo correcto."
