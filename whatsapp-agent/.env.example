# ============================================================
# Variables de Entorno — AgenteIAWhatsAppSV
# ============================================================
# ⚠️ ACCIÓN REQUERIDA:
#   1. Copia este archivo: cp .env.example .env
#   2. Rellena CADA valor con tus credenciales reales
#   3. NUNCA subas el archivo .env a GitHub
# ============================================================

# --- Claude API (Anthropic) ---
# ← PONER TU API KEY: https://console.anthropic.com/settings/keys
CLAUDE_API_KEY=sk-ant-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# --- Google Sheets ---
# ← PONER TU ID DE HOJA: Es el código largo en la URL de tu Google Sheet
#   Ejemplo URL: https://docs.google.com/spreadsheets/d/ESTE_CODIGO/edit
GOOGLE_SHEETS_ID=1BxiMVs0XRA5nFMdKvBdBZjgmUUqptlbs74OgVE2upms

# ← PONER TUS CREDENCIALES: Contenido completo del JSON de tu cuenta de servicio
#   (Ver SETUP.md paso 4 para instrucciones detalladas)
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"...","client_email":"..."}

# --- Servidor ---
# Puerto del servidor (Render/Railway lo asignan automáticamente — no cambiar)
PORT=3000
